@model IEnumerable<actividad01.Models.Archivo>
@{
    int index = 1;
}

<div class="mt-3 row">
    <div class="col-sm-12 col-md-6">
        <h4>Almacenamiento</h4>
    </div>
    <div class="col-sm-12 col-md-6 text-end">
        <a class="btn btn-sm btn-outline-primary" asp-controller="Archivo" asp-action="Create">
            Guardar archivo
        </a>
    </div>
    
    <div class="col-sm-12">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Formato</th>
                    <th>Registro</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (Archivo item in Model)
                {
                    <tr>
                        <td scope="row">@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.Descripcion</td>
                        <td>@item.Extension!.Replace(".", "")</td>
                        <td>@item.Registro</td>
                        <td>
                            <a class="btn btn-sm btn-outline-warning" 
                                href="@item.Url"
                                target="_blank"
                            >
                                Ver
                            </a>
                            <a class="btn btn-sm btn-outline-danger" 
                                asp-controller="Archivo" 
                                asp-route-id="@item.Id" 
                                asp-action="Destroy">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>
