@model actividad01.Models.Archivo

<div class="mt-3 row">
    <div class="col-sm-12 col-md-6">
        <h4>Archivo @Model.Nombre</h4>
    </div>

    <div class="col-sm-12 col-md-12 mt-5">
        <form
            asp-action="DestroyAction"
            asp-controller="Archivo"
            method="post"
        >
            <div class="row">
                <div class="col-sm-12">
                    <h4>¿Estas seguro de eliminar el archivo?</h4>
                    <input type="hidden" name="id" value="@Model.Id">
                </div>

                <div class="col-sm-12 text-end">
                    <a class="btn btn-sm btn-outline-danger" aria-current="page" asp-controller="Archivo" asp-action="Index">
                        Cancelar
                    </a>
                    <button
                        type="submit"
                        class="btn btn-sm btn-success"
                    >
                        Eliminar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
