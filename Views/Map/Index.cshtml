<style>
    #map { height: 180px; }
</style>
<link rel="stylesheet" href="https://cdn.hugeicons.com/font/hgi-stroke-rounded.css" />

<div class="row mt-3">
    <div
        class="col-6"
    >
        <h2 id="onSocket">Mapa</h2>
    </div>
    <div
        class="col-6 d-flex justify-content-end"
    >
        <button
            id="btnSearch"
            class="btn btn-md btn-outline-primary"
            style="display: flex; align-items: center;"
        >
            <i
                class="hgi hgi-stroke hgi-share-location-01 icon-spi"
                style="font-size: 24px; padding-right: 5px;"
            ></i>
            <span id="title">
                Buscar
            </span>
        </button>
    </div>
</div>

 <div class="mt-3" id="map" style="width: 100%; height: 800px;"></div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/9.0.6/signalr.min.js"></script>
    <script>
        const conexion = new signalR.HubConnectionBuilder().withUrl("/map-hub").build();
        const map = L.map('map').setView([19.883088,-97.392879,15], 15);

        const btnSearch = document.getElementById("btnSearch");
        const originalIconClass = "hgi hgi-stroke hgi-share-location-01";
        const originalText = "Buscar";

        conexion.start().then(() => {
            document.getElementById("onSocket").textContent = "Mapa Online";
            const tiles = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 2,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            var marker = L.marker([19.883088,-97.392879]).addTo(map).bindPopup(`
                <b>TecNM Teziutlan</b><br>
                <small>Lat: ${19.883088}, Lng: ${-97.392879}</small>
            `);
            iIcon.className = originalIconClass;
            iSpan.textContent = originalText;
            btnSearch.disabled = false;
        }).catch((error) => {
            console.log(error);
            document.getElementById("onSocket").textContent = "Mapa Offline";
            iIcon.className = "hgi hgi-stroke hgi-alert-01";
            iSpan.textContent = "Error";
            btnSearch.disabled = true;
        });

        const iIcon = btnSearch.querySelector("i");
        const iSpan = btnSearch.querySelector("span");

        btnSearch.addEventListener("click", async () => {
            btnSearch.disabled = true;
            iIcon.className = "hgi hgi-stroke hgi-loading-03 icon-spin";
            iSpan.textContent = "Buscando...";

            await fetch("https://randomuser.me/api/")
            .then(response => response.json())
            .then(data => {
                for(let usr of data.results){
                    const {
                        coordinates
                    } = usr.location;
                    conexion.invoke("SendMarker", "Nuevo usuario", usr).catch((error) => {
                        console.log(error);
                    });
                    
                    iIcon.className = originalIconClass;
                    iSpan.textContent = originalText;
                    btnSearch.disabled = false;
                }
            })
            .catch((err) => {
                iIcon.className = "hgi hgi-stroke hgi-alert-01";
                iSpan.textContent = "Error";
                
                setTimeout(() => {
                    iIcon.className = originalIconClass;
                    iSpan.textContent = originalText;
                    btnSearch.disabled = false;
                }, 3000);
            });
        });

        conexion.on("ReceiveMarker", (msg, usr) => {
            const {
                coordinates
            } = usr.location;

            const {
                title,
                first,
                last
            } = usr.name;
            var marker = L.marker([coordinates.latitude, coordinates.longitude])
            .addTo(map)
            .bindPopup(`
                <b>${title}. ${first} ${last}</b><br>
                ${usr.email}<br>
                <small>Lat: ${coordinates.latitude}, Lng: ${coordinates.longitude}</small>
            `);
        }); 
    </script>
}