@model IEnumerable<actividad01.Models.Mantenimiento>
@{
    int index = 1;
}

<div class="mt-3 row">
    <div class="col-sm-12 col-md-6">
        <h4>Listado de mantenimiento</h4>
    </div>
    <div class="col-sm-12 col-md-6 text-end">
        <a class="btn btn-sm btn-outline-primary" asp-controller="Mantenimiento" asp-action="Create">
            Crear mantenimiento
        </a>
    </div>
    
    <div class="col-sm-12">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Marca</th>
                    <th>Diagnostico</th>
                    <th align="center">Precio</th>
                    <th align="center">Tecnico</th>
                    <th align="center">Registro</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (Mantenimiento item in Model)
                {
                    <tr>
                        <td scope="row">@item.Id</td>
                        <td>@item.Marca</td>
                        <td>@item.Diagnostico</td>
                        <td align="center">$@item.Precio?.ToString("N2")</td>
                        <td align="center">@item.Tecnico</td>
                        <td align="center">@item.Registro</td>
                        <td>
                            <a class="btn btn-sm btn-outline-warning" 
                                asp-controller="Mantenimiento" 
                                asp-route-id="@item.Id" 
                                asp-action="Update">
                                Actualizar
                            </a>
                            <a class="btn btn-sm btn-outline-danger" 
                                asp-controller="Mantenimiento" 
                                asp-route-id="@item.Id" 
                                asp-action="Destroy">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>