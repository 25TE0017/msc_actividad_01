@model actividad01.Models.Mantenimiento

<div class="mt-3 row">
    <div class="col-sm-12 col-md-6">
        <h4>Mantenimiento @Model.Marca </h4>
    </div>
    <div class="col-sm-12 col-md-6 text-end">
        <a class="btn btn-sm btn-outline-primary" aria-current="page" asp-controller="Mantenimiento" asp-action="Index">
            Ver listado
        </a>
    </div>
    <div class="col-sm-12 col-md-12 mt-5">
        <form
            asp-action="Update"
            asp-controller="Mantenimiento"
            method="post"
        >
            <div class="row">
                <div class="col-sm-12">
                    <h4>Datos</h4>
                </div>
                <div class="mb-3 col-sm-12 col-md-6">
                    <label class="form-label">Marca</label>
                    <input type="text" class="form-control" id="Marca" name="Marca" asp-for="Marca" readonly>
                </div>

                <div class="mb-3 col-sm-12">
                    <label class="form-label">Diagnostico</label>
                    <input type="text" class="form-control" id="Diagnostico" name="Diagnostico" asp-for="Diagnostico">
                    <span asp-validation-for="Diagnostico" class="text-danger"></span>
                </div>

                <div class="mb-3 col-sm-12 col-md-4">
                    <label class="form-label">Precio</label>
                    <input type="text" class="form-control" id="Precio" name="Precio" asp-for="Precio">
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>

                <div class="mb-3 col-sm-12 col-md-8">
                    <label class="form-label">Técnico</label>
                    @* <input type="text" class="form-control" id="Tecnico" name="Tecnico" asp-for="Tecnico"> *@
                    <select class="form-select" id="Tecnico" name="Tecnico" asp-for="Tecnico">
                    <option selected>Selecciona un técnico</option>
                        <option value="Oscar Martinez">Oscar Martinez</option>
                        <option value="Ricardo Garci">Ricardo Garcia</option>
                        <option value="Marco Aguilar">Marco Aguilar</option>
                    </select>
                    <span asp-validation-for="Tecnico" class="text-danger"></span>
                </div>

                <div class="col-sm-12 text-end">
                    <button
                        type="submit"
                        class="btn btn-sm btn-outline-warning"
                    >
                        Actualizar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
