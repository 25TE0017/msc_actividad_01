@model actividad01.Models.AlumnoDireccionViewModel

<div class="mt-3 row">
    <div class="col-sm-12 col-md-6">
        <h4>Registro de alumno</h4>
    </div>
    <div class="col-sm-12 col-md-6 text-end">
        <a class="btn btn-sm btn-outline-primary" aria-current="page" asp-controller="Studient" asp-action="Consultar">
            Ver listado
        </a>
    </div>
    <div class="col-sm-12 col-md-12 mt-5">
        <form
            asp-action="Register"
            asp-controller="Studient"
            mathod="post"
        >
            <div class="row">
                <div class="col-sm-12">
                    <h4>Datos</h4>
                </div>
                <div class="mb-3 col-sm-12 col-md-6">
                    <label class="form-label">Nombre completo</label>
                    <input type="text" class="form-control" id="Alumno.Nombre" name="Alumno.Nombre" asp-for="Alumno.Nombre">
                    <span asp-validation-for="Alumno.Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3 col-sm-12 col-md-6">
                    <label class="form-label">No.Control</label>
                    <input type="text" class="form-control" id="Alumno.NoControl" name="Alumno.NoControl" asp-for="Alumno.NoControl">
                    <span asp-validation-for="Alumno.NoControl" class="text-danger"></span>
                </div>

                <div class="mb-3 col-sm-12">
                    <h4>Dirección</h4>
                </div>

                <div class="mb-3 col-sm-12 col-md-3">
                    <label class="form-label" asp-for="Direccion.CP"></label>
                    <input type="number" class="form-control" id="Direccion.CP" name="Direccion.CP" asp-for="Direccion.CP">
                    <span asp-validation-for="Direccion.CP" class="text-danger"></span>
                </div>
                
                <div class="mb-3 col-sm-12 col-md-9">
                    <label class="form-label" asp-for="Direccion.Calle"></label>
                    <input type="text" class="form-control" id="Direccion.Nombre" name="Direccion.Calle" asp-for="Direccion.Calle">
                    <span asp-validation-for="Direccion.Calle" class="text-danger"></span>
                </div>

                <div class="col-sm-12 text-end">
                    <button
                        type="submit"
                        class="btn btn-sm btn-outline-primary"
                    >
                        Registrar
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
