@model actividad01.Models.Login

<div class="mt-3">
    <form
        asp-action="Login"
        asp-controller="Studient"
        mathod="post"
    >
        <div class="mb-3 col-sm-12 col-md-4">
            <label for="exampleFormControlInput1" class="form-label">Usuario</label>
            <input type="text" class="form-control" id="Usuario" name="Usuario" asp-for="Usuario" placeholder="Usuario">
            <span asp-validation-for="Usuario"></span>
        </div>

        <div class="mb-3 col-sm-12 col-md-4">
            <label for="exampleFormControlInput1" class="form-label">Contraseña</label>
            <input type="password" class="form-control" id="Password" name="Password" asp-for="Password" placeholder="*******">
            <span asp-validation-for="Password"></span>
        </div>

        <button
            type="submit"
            class="btn btn-primary"
        >
            Enviar
        </button>
    </form>
</div>
